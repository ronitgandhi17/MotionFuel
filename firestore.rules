rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // MotionFuel connects the Firebase client SDK directly. Every private document lives under
    // users/{userId}/... and is readable/writable only by that authenticated user. Ownership is
    // enforced here from the verified request.auth.uid, so a client can never reach another
    // account's data even if it forges an owner field (NFR-10).
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
