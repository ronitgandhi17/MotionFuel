rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function verifiedAs(uid) {
      return signedInAs(uid) && request.auth.token.email_verified == true;
    }

    function validProfile(data) {
      return data.keys().hasOnly([
          'name', 'email', 'age', 'sex', 'heightCm', 'weightKg',
          'activityLevel', 'activityFactor', 'maintenanceCaloriesKcal',
          'dailyCalorieGoalKcal', 'photoUrl', 'profileComplete', 'createdAt', 'updatedAt'
        ])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.email is string && data.email == request.auth.token.email
        && data.age is int && data.age >= 13 && data.age <= 120
        && data.sex in ['MALE', 'FEMALE']
        && data.heightCm is number && data.heightCm >= 100 && data.heightCm <= 250
        && data.weightKg is number && data.weightKg >= 30 && data.weightKg <= 350
        && data.activityLevel in ['SEDENTARY', 'LIGHT', 'MODERATE', 'VERY_ACTIVE', 'EXTREMELY_ACTIVE']
        && data.activityFactor is number && data.activityFactor >= 1.2 && data.activityFactor <= 1.9
        && data.maintenanceCaloriesKcal is int && data.maintenanceCaloriesKcal >= 100 && data.maintenanceCaloriesKcal <= 10000
        && data.dailyCalorieGoalKcal is int && data.dailyCalorieGoalKcal >= 100 && data.dailyCalorieGoalKcal <= 10000
        && (!('photoUrl' in data) || data.photoUrl == null
          || (data.photoUrl is string && data.photoUrl.size() <= 2048))
        && data.profileComplete == true
        && data.createdAt is timestamp
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function validWeightEntry(data) {
      return data.keys().hasOnly(['weightKg', 'recordedAt'])
        && data.weightKg is number && data.weightKg >= 30 && data.weightKg <= 350
        && data.recordedAt is timestamp;
    }

    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function validSafetyShare(data) {
      return data.keys().hasOnly(['ownerUid', 'expiresAtMillis', 'active', 'latitude', 'longitude', 'updatedAtMillis'])
        && data.ownerUid == request.auth.uid
        && data.expiresAtMillis is int
        && data.expiresAtMillis > request.time.toMillis()
        && data.expiresAtMillis <= request.time.toMillis() + 3600000
        && data.active is bool
        && data.updatedAtMillis is int
        && (!('latitude' in data) || data.latitude == null || (data.latitude is number && data.latitude >= -90 && data.latitude <= 90))
        && (!('longitude' in data) || data.longitude == null || (data.longitude is number && data.longitude >= -180 && data.longitude <= 180));
    }

    match /users/{uid} {
      allow create: if signedInAs(uid)
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow read: if verifiedAs(uid);
      allow update: if verifiedAs(uid)
        && validProfile(request.resource.data)
        && (
          ((!('profileComplete' in resource.data) || resource.data.profileComplete != true)
            && request.resource.data.createdAt == request.time)
          || (resource.data.profileComplete == true
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.updatedAt == request.time)
        );
      allow delete: if verifiedAs(uid);

      match /weightEntries/{entryId} {
        allow read, delete: if verifiedAs(uid);
        allow create, update: if verifiedAs(uid) && validWeightEntry(request.resource.data);
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /safetyShares/{token} {
      allow create: if verified() && validSafetyShare(request.resource.data);
      allow read: if verified() && (resource.data.ownerUid == request.auth.uid
        || (resource.data.active == true && resource.data.expiresAtMillis > request.time.toMillis()));
      allow update: if verified() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.expiresAtMillis == resource.data.expiresAtMillis
        && validSafetyShare(request.resource.data);
      allow delete: if verified() && resource.data.ownerUid == request.auth.uid;
    }

    match /challenges/{challengeId} {
      allow read: if verified();
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['title', 'metric', 'target', 'endsAtMillis', 'ownerUid'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() >= 2 && request.resource.data.title.size() <= 100
        && request.resource.data.metric in ['km', 'steps', 'days']
        && request.resource.data.target is number && request.resource.data.target > 0 && request.resource.data.target <= 100000
        && request.resource.data.endsAtMillis is int && request.resource.data.endsAtMillis > request.time.toMillis();
      allow update, delete: if verified() && resource.data.ownerUid == request.auth.uid;

      match /members/{uid} {
        allow read: if verified();
        allow create, update: if verifiedAs(uid)
          && request.resource.data.keys().hasOnly(['displayName', 'score'])
          && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 100
          && request.resource.data.score is number && request.resource.data.score >= 0 && request.resource.data.score <= 1000000;
        allow delete: if verifiedAs(uid);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
