# Copy this file to secrets.properties (git-ignored) and set your client-safe Google Maps key.
#
# Firebase needs NO value here: place google-services.json at app/google-services.json instead
# (also git-ignored). Without it the app still builds and shows a "configure Firebase" gate.
#
# MAPS_API_KEY is safe to ship in the APK when restricted by SHA-1 + package name in the
# Google Cloud console. Leave it blank to fall back to the offline RouteCanvas.
MAPS_API_KEY=
