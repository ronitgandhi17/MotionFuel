<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="database" path="motionfuel.db" />
        <exclude domain="database" path="motionfuel.db-shm" />
        <exclude domain="database" path="motionfuel.db-wal" />
        <exclude domain="file" path="datastore/motionfuel.preferences_pb" />
        <exclude domain="cache" path="shared_activities/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="motionfuel.db" />
        <exclude domain="database" path="motionfuel.db-shm" />
        <exclude domain="database" path="motionfuel.db-wal" />
        <exclude domain="file" path="datastore/motionfuel.preferences_pb" />
        <exclude domain="cache" path="shared_activities/" />
    </device-transfer>
</data-extraction-rules>
