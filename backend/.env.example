# Clerk publishable and secret keys let the server verify Android session tokens.
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
# Stripe secret configuration must exist only on this server and never in the APK.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRO_MONTHLY_PRICE_ID=price_replace_me
# Stripe redirects users to this HTTPS page after they leave Customer Portal.
MEMBERSHIP_RETURN_URL=https://your-site.example.com/account
# The hosting provider may override this local development port.
PORT=4242
