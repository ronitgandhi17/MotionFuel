rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /backups/{uid}/{fileName} {
      allow read, delete: if signedInAs(uid) && request.auth.token.email_verified == true;
      allow create: if resource == null && signedInAs(uid) && request.auth.token.email_verified == true
        && fileName.matches('[a-f0-9-]{36}[.]json')
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType == 'application/json';
    }

    match /profile-images/{uid}/avatar {
      allow read, delete: if signedInAs(uid);
      allow create, update: if signedInAs(uid)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
